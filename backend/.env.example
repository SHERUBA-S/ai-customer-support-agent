# Application Settings
PROJECT_NAME="AI Customer Support Agent"
HOST="127.0.0.1"
PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Admin Authentication
# NOTE: In production, use a strong randomly-generated SECRET_KEY and a secure password!
SECRET_KEY="customer-support-rag-super-secret-key-change-in-production"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Directories
CHROMA_PERSIST_DIRECTORY="./data/chroma_db"
UPLOAD_DIRECTORY="./data/uploads"

# RAG & Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=4
RELEVANCE_THRESHOLD=0.10

# LLM Provider Configuration
# Options: "mock" (zero API key required, grounded rule-based dev mode), "openai", "gemini", "ollama"
LLM_PROVIDER="mock"

# OpenAI Configuration (leave empty if not using)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini Configuration (leave empty if not using)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Ollama Configuration (leave empty if not using)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Embedding Provider Configuration
# Options: "local" (fast local embedding engine, no API keys or large downloads needed), "openai", "gemini", "ollama"
EMBEDDING_PROVIDER="local"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
