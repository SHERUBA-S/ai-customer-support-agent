# Application Settings
PROJECT_NAME="AI Customer Support Agent"
HOST="127.0.0.1"
PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Admin Authentication
# NOTE: In production, generate a secure random SECRET_KEY and use strong credentials!
SECRET_KEY="customer-support-rag-super-secret-key-change-in-production"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Directories
CHROMA_PERSIST_DIRECTORY="./data/chroma_db"
UPLOAD_DIRECTORY="./data/uploads"

# RAG & Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=4
RELEVANCE_THRESHOLD=0.10

# LLM Provider Configuration
# Options: "mock" (offline zero-API-key dev mode), "openai", "gemini", "ollama"
LLM_PROVIDER="mock"

# External API Keys (Fill in if using commercial providers)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini API Configuration (Fill in if using Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Ollama Local LLM Configuration (Fill in if using local Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Embedding Provider Configuration
# Options: "local" (zero-dependency semantic embedder), "openai", "gemini", "ollama"
EMBEDDING_PROVIDER="local"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
